# Ferry Watch as a plain container, outside Home Assistant (see DOCS.md, "Running without
# Home Assistant"). The add-on is built from Dockerfile; this one from the same app folder.
FROM python:3.14-alpine

COPY app/requirements.txt /app/requirements.txt
# gcc is only needed if a wheel is missing for this Python/arch; removed afterwards.
RUN apk add --no-cache --virtual .build-deps gcc musl-dev \
    && pip3 install --no-cache-dir -r /app/requirements.txt \
    && apk del .build-deps \
    && apk add --no-cache tzdata

COPY app /app
COPY CHANGELOG.md /app/CHANGELOG.md
WORKDIR /app

ENV FW_STANDALONE=1 \
    FW_DATA_DIR=/data \
    FW_PORT=8099 \
    TZ=Europe/Helsinki \
    PYTHONUNBUFFERED=1
VOLUME /data
EXPOSE 8099
HEALTHCHECK --interval=1m --timeout=10s --start-period=1m \
    CMD wget -q -O /dev/null http://127.0.0.1:8099/api/health || exit 1
CMD ["python3", "-m", "ferrywatch"]
